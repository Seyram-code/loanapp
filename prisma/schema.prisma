generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  LOAN_OFFICER
  ACCOUNTANT
  MANAGER
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum LoanStatus {
  DRAFT
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  DISBURSED
  ACTIVE
  COMPLETED
  DEFAULTED
  CANCELLED
}

enum InterestType {
  FLAT
  REDUCING_BALANCE
}

enum RepaymentFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
}

enum LoanTermUnit {
  DAY
  WEEK
  MONTH
}

enum RepaymentStatus {
  PENDING
  PAID
  LATE
  MISSED
}

enum ScheduleStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  WAIVED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CARD
  OTHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum LoanTypeStatus {
  ACTIVE
  INACTIVE
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  LOAN
  REPAYMENT
  SYSTEM
}

model User {
  id           String     @id @default(cuid())
  name         String     @db.VarChar(120)
  email        String     @unique @db.VarChar(191)
  passwordHash String     @db.VarChar(255)
  role         Role       @default(ADMIN)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lastLoginAt  DateTime?
  auditLogs    AuditLog[]
  createdLoans Loan[]     @relation("LoanCreatedBy")
  approvedLoans Loan[]    @relation("LoanApprovedBy")
  disbursedLoans Loan[]   @relation("LoanDisbursedBy")
  loanDisbursements LoanDisbursement[] @relation("LoanDisbursementBy")
  recordedRepayments Repayment[] @relation("RepaymentRecordedBy")
  notifications Notification[]

  @@index([role, status])
  @@index([status, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  title     String           @db.VarChar(160)
  message   String           @db.Text
  type      NotificationType
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read, createdAt])
  @@index([userId, type, createdAt])
}

model SystemSetting {
  id                       String             @id @default("default") @db.VarChar(32)
  organizationName        String             @default("Lendgh") @db.VarChar(160)
  organizationLogoUrl     String?            @db.VarChar(512)
  address                 String?            @db.VarChar(255)
  phone                   String?            @db.VarChar(32)
  email                   String?            @db.VarChar(191)
  currency                String             @default("GHS") @db.VarChar(8)
  dateFormat              String             @default("DD/MM/YYYY") @db.VarChar(32)
  defaultInterestRate     Decimal            @default(0) @db.Decimal(5, 2)
  defaultLoanTerm         Int                @default(12)
  defaultRepaymentFrequency RepaymentFrequency @default(MONTHLY)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
}

model Customer {
  id                            String         @id @default(cuid())
  customerNumber                String         @unique @db.VarChar(16)
  firstName                     String         @db.VarChar(80)
  middleName                    String?        @db.VarChar(80)
  lastName                      String         @db.VarChar(80)
  dateOfBirth                   DateTime?
  gender                        Gender?
  phone                         String         @db.VarChar(32)
  alternatePhone                String?        @db.VarChar(32)
  email                         String?        @db.VarChar(191)
  address                       String?        @db.VarChar(255)
  city                          String?        @db.VarChar(80)
  region                        String?        @db.VarChar(80)
  country                       String         @default("Ghana") @db.VarChar(80)
  nationalId                    String?        @unique @db.VarChar(64)
  occupation                    String?        @db.VarChar(120)
  employer                      String?        @db.VarChar(120)
  monthlyIncome                 Decimal?       @db.Decimal(14, 2)
  emergencyContactName          String?        @db.VarChar(160)
  emergencyContactPhone         String?        @db.VarChar(32)
  emergencyContactRelationship  String?        @db.VarChar(80)
  status                        CustomerStatus @default(ACTIVE)
  notes                         String?        @db.Text
  referredByCustomerId          String?
  referredBy                    Customer?      @relation("CustomerReferrals", fields: [referredByCustomerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  referredCustomers             Customer[]     @relation("CustomerReferrals")
  createdAt                     DateTime       @default(now())
  updatedAt                     DateTime       @updatedAt
  loans                         Loan[]
  repayments                    Repayment[]

  @@index([lastName, firstName])
  @@index([phone])
  @@index([email])
  @@index([status, createdAt])
  @@index([referredByCustomerId])
}

model Loan {
  id                  String             @id @default(cuid())
  loanNumber          String             @unique @db.VarChar(32)
  customerId          String
  customer            Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rolloverFromLoanId  String?            @unique
  rolloverFromLoan    Loan?              @relation("LoanRollover", fields: [rolloverFromLoanId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rolloverToLoan      Loan?              @relation("LoanRollover")
  loanTypeId          String
  loanType            LoanType           @relation(fields: [loanTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  requestedAmount     Decimal            @db.Decimal(14, 2)
  approvedAmount      Decimal?           @db.Decimal(14, 2)
  interestRate        Decimal            @db.Decimal(5, 2)
  interestType        InterestType
  term                Int
  termUnit            LoanTermUnit       @default(MONTH)
  repaymentFrequency  RepaymentFrequency
  purpose             String?            @db.VarChar(255)
  applicationDate     DateTime           @default(now())
  approvalDate        DateTime?
  disbursementDate    DateTime?
  maturityDate        DateTime?
  status              LoanStatus         @default(DRAFT)
  rejectionReason     String?            @db.Text
  notes               String?            @db.Text
  createdById         String
  createdBy           User               @relation("LoanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  approvedById        String?
  approvedBy          User?              @relation("LoanApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  disbursedById       String?
  disbursedBy         User?              @relation("LoanDisbursedBy", fields: [disbursedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  repayments          Repayment[]
  repaymentSchedules  LoanRepaymentSchedule[]
  disbursements       LoanDisbursement[]

  @@index([customerId, status])
  @@index([loanTypeId, status])
  @@index([createdById, createdAt])
  @@index([approvedById, approvalDate])
  @@index([disbursedById, disbursementDate])
  @@index([status, maturityDate])
  @@index([applicationDate])
  @@index([createdAt])
}

model LoanType {
  id                    String              @id @default(cuid())
  name                  String              @unique @db.VarChar(100)
  description           String?             @db.Text
  defaultInterestRate   Decimal             @db.Decimal(5, 2)
  defaultTerm           Int
  defaultTermUnit       LoanTermUnit        @default(MONTH)
  repaymentFrequency    RepaymentFrequency
  minimumAmount         Decimal             @db.Decimal(14, 2)
  maximumAmount         Decimal             @db.Decimal(14, 2)
  status                LoanTypeStatus     @default(ACTIVE)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  loans                 Loan[]

  @@index([status, name])
}

model NumberSequence {
  key       String   @id @db.VarChar(32)
  nextValue Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LoanRepaymentSchedule {
  id                String         @id @default(cuid())
  loanId            String
  loan              Loan           @relation(fields: [loanId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  installmentNumber Int
  dueDate           DateTime
  expectedAmount    Decimal        @db.Decimal(14, 2)
  principalAmount   Decimal        @db.Decimal(14, 2)
  interestAmount    Decimal        @db.Decimal(14, 2)
  amountPaid        Decimal        @default(0) @db.Decimal(14, 2)
  remainingAmount   Decimal        @db.Decimal(14, 2)
  status            ScheduleStatus @default(PENDING)
  paidDate          DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([loanId, installmentNumber])
  @@index([loanId, dueDate])
  @@index([status, dueDate])
}

model LoanDisbursement {
  id              String        @id @default(cuid())
  loanId          String
  loan            Loan          @relation(fields: [loanId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  amount          Decimal       @db.Decimal(14, 2)
  disbursementDate DateTime
  paymentMethod   PaymentMethod
  referenceNumber String?       @db.VarChar(100)
  notes           String?       @db.Text
  disbursedById   String
  disbursedBy     User          @relation("LoanDisbursementBy", fields: [disbursedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt       DateTime      @default(now())

  @@index([loanId, disbursementDate])
  @@index([disbursedById, createdAt])
  @@index([paymentMethod, disbursementDate])
}

model Repayment {
  id              String          @id @default(cuid())
  repaymentNumber String          @unique @db.VarChar(32)
  loanId          String
  loan            Loan            @relation(fields: [loanId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  customerId      String
  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  amount          Decimal         @db.Decimal(14, 2)
  paymentDate     DateTime
  paymentMethod   PaymentMethod
  referenceNumber String?         @db.VarChar(100)
  notes           String?         @db.Text
  recordedById    String
  recordedBy      User            @relation("RepaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  status          RepaymentStatus @default(PAID)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([loanId, paymentDate])
  @@index([customerId, paymentDate])
  @@index([recordedById, createdAt])
  @@index([paymentMethod, paymentDate])
  @@index([status, paymentDate])
  @@index([paymentDate])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  action      String   @db.VarChar(64)
  entity      String   @db.VarChar(64)
  entityId    String?  @db.VarChar(64)
  description String   @db.VarChar(255)
  ipAddress   String?  @db.VarChar(45)
  userAgent   String?  @db.VarChar(512)
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([entity, entityId])
  @@index([entityId])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}
